      <div class="text-[10px] text-brand-muted">
        Designed for Framer & High-Fashion Web UX
      </div>

    </div>
  </footer>

  <!-- ==================== GENERIC DETAIL MODAL ==================== -->
  <div id="detailModal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-brand-bg border border-brand-border max-w-2xl w-full max-h-[90vh] overflow-y-auto p-6 md:p-8 relative space-y-6">
      
      <button onclick="closeModal()" class="absolute top-4 right-4 text-brand-dark hover:text-brand-accent p-2">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>

      <div class="space-y-2">
        <span class="text-[10px] uppercase tracking-widest text-brand-accent font-semibold">Detailed Archive Reader</span>
        <h3 id="modalTitle" class="font-serif text-2xl md:text-3xl font-normal">Title Placeholder</h3>
      </div>

      <div id="modalImageContainer" class="h-64 bg-gray-100 overflow-hidden hidden">
        <img id="modalImage" src="" alt="Modal Detail" class="w-full h-full object-cover">
      </div>

      <p id="modalDescription" class="text-xs text-brand-dark/80 font-light leading-relaxed">
        Description content goes here.
      </p>

      <div class="pt-4 border-t border-brand-border flex justify-between items-center text-xs">
        <span class="text-brand-muted">AESTHETE & STRATEGY Archive</span>
        <button onclick="closeModal()" class="px-4 py-2 bg-brand-dark text-white text-[10px] uppercase tracking-widest">关闭窗口</button>
      </div>

    </div>
  </div>

  <!-- ==================== JAVASCRIPT LOGIC ==================== -->
  <script>
    // 1. Mobile Navigation Toggle
    function toggleMobileMenu() {
      const menu = document.getElementById('mobileMenu');
      const icon = document.getElementById('menuIcon');
      menu.classList.toggle('hidden');
      if (menu.classList.contains('hidden')) {
        icon.className = 'fa-solid fa-bars';
      } else {
        icon.className = 'fa-solid fa-xmark';
      }
    }

    // 2. Category Filter Handler
    function filterContent(category) {
      // Update Tab CSS Active States
      const tabs = document.querySelectorAll('.tab-btn');
      tabs.forEach(tab => {
        if (tab.getAttribute('data-category') === category) {
          tab.classList.add('tab-active');
          tab.classList.remove('text-brand-muted');
        } else {
          tab.classList.remove('tab-active');
          tab.classList.add('text-brand-muted');
        }
      });

      // Filter Grid Items
      const cards = document.querySelectorAll('.content-card');
      cards.forEach(card => {
        if (category === 'all') {
          card.style.display = 'block';
        } else {
          if (card.classList.contains(category)) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        }
      });
    }

    // 3. Counterpoint Lab Dimension Switcher
    const dimensions = {
      price: {
        fmcgTitle: "高频复购与性价比定位",
        fmcgDesc: "基于 COGS（销货成本）与边际效应定价，强调性价比、爆款促销与即时购买欲望触发。通过大规模生产降低成本。",
        luxuryTitle: "情感溢价与稀缺性控制",
        luxuryDesc: "脱离单纯功能价值，基于品牌历史、工艺与身份象征定价。通过配货制度、配额限量与定期涨价强化“稀缺资产”属性。"
      },
      channel: {
        fmcgTitle: "铺货广度与无缝购买 (Omnichannel)",
        fmcgDesc: "追求极高的渠道渗透率：便利店、电商直播、外卖到家与超市货架，降低消费者的任何购买阻力。",
        luxuryTitle: "选择性筛选与专属体验 (VIC Only)",
        luxuryDesc: "严格限制销售渠道：品牌直营旗舰店、高端百货一楼与邀请制 VIP 线下包厢。刻意制造距离感与仪式感。"
      },
      story: {
        fmcgTitle: "爆款功能与痛点解决",
        fmcgDesc: "聚焦于产品卖点（如“成分、功效、性价比、潮流IP”），用接地气、高传播力的社交梗引起共鸣。",
        luxuryTitle: "神话塑造与文化传承 (Mythology)",
        luxuryDesc: "讲述创始人传奇、高定工坊手工沉淀与艺术跨界。不强调“实用功能”，而是卖对理想生活方式的向往。"
      },
      customer: {
        fmcgTitle: "流量转化与私域裂变",
        fmcgDesc: "依靠大规模 Seed 种草与优惠券引流，建立高频交易的会员积分体系，提升单个用户的 LTV（生命周期价值）。",
        luxuryTitle: "专属 VIC 客户关系管理 (CRM)",
        luxuryDesc: "对前 2% 顶尖客户提供一对一销售服务（Clientele），提供高定大秀门票、生日私人定制与闭门艺术展览。"
      }
    };

    function switchDimension(key) {
      // Update Buttons
      const btns = document.querySelectorAll('.counter-btn');
      btns.forEach(btn => {
        if (btn.getAttribute('data-dim') === key) {
          btn.className = "counter-btn px-4 py-2 border border-brand-dark text-xs uppercase tracking-widest bg-brand-dark text-white";
        } else {
          btn.className = "counter-btn px-4 py-2 border border-brand-border text-xs uppercase tracking-widest text-brand-muted hover:border-brand-dark hover:text-brand-dark";
        }
      });

      // Update Text Content
      const data = dimensions[key];
      document.getElementById('fmcgTitle').innerText = data.fmcgTitle;
      document.getElementById('fmcgDesc').innerText = data.fmcgDesc;
      document.getElementById('luxuryTitle').innerText = data.luxuryTitle;
      document.getElementById('luxuryDesc').innerText = data.luxuryDesc;
    }

    // 4. Modal Reader Controls
    function openDetailModal(title, desc, imgUrl) {
      document.getElementById('modalTitle').innerText = title;
      document.getElementById('modalDescription').innerText = desc;
      
      const imgContainer = document.getElementById('modalImageContainer');
      const img = document.getElementById('modalImage');
      
      if (imgUrl && imgUrl.trim() !== '') {
        img.src = imgUrl;
        imgContainer.classList.remove('hidden');
      } else {
        imgContainer.classList.add('hidden');
      }

      document.getElementById('detailModal').classList.remove('hidden');
    }

    function openHeroModal() {
      openDetailModal(
        'YSL 品牌视觉与暗黑极简主义解析', 
        '详细分析：YSL 如何通过黑色、锐利剪裁与高冷视角的平面视觉，建立不可替代的时尚门槛，并实现高单价香水与口红产品的快速溢价。',
        'https://images.unsplash.com/photo-1509631179647-0177331693ae?auto=format&fit=crop&w=1400&q=80'
      );
    }

    function closeModal() {
      document.getElementById('detailModal').classList.add('hidden');
    }

    function toggleSearchModal() {
      alert('搜索功能已激活：可在 Framer 中直接连接 CMS 数据库完成实效搜索！');
    }
  </script>
</body>
</html>
